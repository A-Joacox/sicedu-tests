# Copia este archivo como .env (en la misma carpeta) y complétalo. El .env NO se comparte.

# URL de QA (la de la pantalla de inicio de sesión, sin /login)
QA_BASE_URL=https://qa-huascaran.ingsoftware.lat

# Supervisora E2E de QA (la del seed sembrar-e2e). Solo se usa por la API.
QA_SUPERVISOR_CORREO=
QA_SUPERVISOR_CLAVE=

# Tu correo: las cuentas de la suite usan alias usuario+sicedu-<etiqueta>@dominio
QA_CORREO_USUARIO=joaquin.mercado
QA_CORREO_DOMINIO=utec.edu.pe

# Clave que tendrán las 7 cuentas de la suite después de su primer ingreso.
# Mínimo 8 caracteres, con mayúscula, minúscula, número y un carácter especial (por ejemplo #).
QA_CLAVE_CUENTAS=

# true = sin ventana del navegador; false = ver el navegador mientras corre (también: correr.bat --ver)
QA_HEADLESS=true
